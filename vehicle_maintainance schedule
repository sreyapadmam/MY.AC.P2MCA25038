import requests

DEPOTS_URL = "http://20.207.122.201/evaluation-service/depots"
TASKS_URL = "http://20.207.122.201/evaluation-service/vehicles"


def fetch_data():
    depots=requests.get(DEPOTS_URL).json()["depots"]
    tasks=requests.get(TASKS_URL).json()["vehicles"]
    return depots, tasks


def knapsack(tasks,capacity):
    n = len(tasks)
    dp = [[0]*(capacity+1) for _ in range(n + 1)]

    for i in range(1,n+1):
        duration=tasks[i-1]["Duration"]
        impact=tasks[i-1]["Impact"]

        for h in range(capacity + 1):
            if duration<=h:
                dp[i][h]=max(
                    dp[i-1][h],
                    dp[i-1][h-duration]+impact
                )
            else:
                dp[i][h]=dp[i-1][h]

    selected=[]
    h=capacity

    for i in range(n, 0, -1):
        if dp[i][h]!=dp[i - 1][h]:
            task=tasks[i - 1]
            selected.append(task)
            h-=task["Duration"]

    return selected


def assign_tasks():
    depots,tasks=fetch_data()

    remaining_tasks=tasks.copy()
    result={}

    for depot in depots:
        capacity=depot["mechanichours"]

        selected=knapsack(remaining_tasks, capacity)

        result[depot["ID"]]=selected

        selected_ids = set(t["TaskID"] for t in selected)
        remaining_tasks = [t for t in remaining_tasks if t["TaskID"] not in selected_ids]

    return result


if __name__ == "__main__":
    allocation = assign_tasks()

    for depot_id, tasks in allocation.items():
        print(f"\nDepot {depot_id}:")
        total_time = sum(t["Duration"] for t in tasks)
        total_score = sum(t["Impact"] for t in tasks)

        print(f" Total Time Used: {total_time}")
        print(f" Total Impact: {total_score}")

        for t in tasks:
            print(f"  TaskID: {t['TaskID']}, Duration: {t['Duration']}, Impact: {t['Impact']}")


